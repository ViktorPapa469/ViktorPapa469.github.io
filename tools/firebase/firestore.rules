rules_version = '2';
// Fovea's Firestore security rules. Paste the whole file in the Firebase console:
// Firestore Database -> Rules -> replace everything -> Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function me(uid) { return request.auth != null && request.auth.uid == uid; }

    // Profile details and usage counts: each app writes only its own record. Only the owner reads them (in the console).
    match /users/{uid} {
      allow create, update, delete: if me(uid);
      allow read: if false;
    }

    // "Compare with other users": each app writes its own weekly entry; signed-in apps may count and average them.
    match /weeks/{week}/entries/{uid} {
      allow create, update, delete: if me(uid);
      allow read: if request.auth != null;
    }

    // Feedback: anyone signed in can send; nobody can read it from the app.
    match /feedback/{id} {
      allow create: if request.auth != null;
      allow read, update, delete: if false;
    }

    // Daily reminders: each device saves its own push address and times.
    // The reminder sender on GitHub lists them with the public web key, so listing is open.
    // A push address is useless without Fovea's private push key, which only GitHub holds.
    match /reminders/{uid} {
      allow create, update, delete: if me(uid);
      allow list: if true;
      allow get: if me(uid);
    }

    // Opening Bell (/trade/) notifications: each phone saves its own push address and which alerts it wants.
    // The sender on GitHub lists them with the public web key, exactly like the reminders above.
    match /trade_alerts/{uid} {
      allow create, update, delete: if me(uid);
      allow list: if true;
      allow get: if me(uid);
    }

    // Fovea accounts: each signed-in person reads and writes only their own saved progress.
    match /sync/{uid}/{rest=**} {
      allow read, write: if me(uid);
    }

    // Everything else stays closed.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
